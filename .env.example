# Optional. Local pose detection and camera work without these values.
# gemini, openai (Chat Completions), or ark (Volcengine Responses)
VISION_PROVIDER=
# Set a model that your account can actually access. No default is assumed.
VISION_MODEL=
GEMINI_API_KEY=
VISION_API_KEY=
# Leave blank to use the provider's official endpoint. Server-side only.
VISION_API_BASE=
# Ark example: provider=ark, base=https://ark.cn-beijing.volces.com/api/v3
# model=doubao-seed-2-1-pro-260915 (only if enabled in your account)
# Put the real key in deployment environment variables, never in source control.
