{
  "name": "zhaozhepai",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test src/lib/geometry.test.ts src/domain/*.test.ts server/*.test.ts src/notebook/*.test.ts",
    "test:e2e": "playwright test",
    "build:demo": "node scripts/legacy-demo.mjs",
    "test:demo": "node scripts/legacy-demo.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch --experimental-strip-types --env-file-if-exists=.env server/index.ts",
    "predev": "node scripts/prepare-vision.mjs",
    "prebuild": "node scripts/prepare-vision.mjs",
    "start": "node --experimental-strip-types --env-file-if-exists=.env server/index.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.21",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "9.2.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
